# ============================================================
# HealthyFood Mobile — Environment Variables (Expo)
# Copy this file to .env and fill in your values
# Uses EXPO_PUBLIC_ prefix for client-side env vars
# ============================================================

# ─── API ────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001

# ─── Google Maps ────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Cloudinary (public read) ───────────────────────────────
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ─── Razorpay (public key only) ─────────────────────────────
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ─── App ────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=HealthyFood
